@prefix : <https://example.org/ontology/clinical-trials#> .
@prefix coa: <http://coa.amazon.com/vocab/coa#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix neptune: <http://aws.amazon.com/neptune/vocab/v01/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix wb: <https://ontology-workbench.local/vocab#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# ── Ontology ──────────────────────

<https://example.org/ontology/clinical-trials> a owl:Ontology ;
    rdfs:label "Clinical Trials (synthetic test ontology)" ;
    rdfs:comment "Hand-written reference ontology for the synthetic clinical trial test dataset. Use it for the manual-upload path, or as a gold standard to compare against the induced ontology." .

<urn:ontology:upload-173f21fe> a owl:Ontology ;
    dct:created "2026-10-25T12:57:40.714570+00:00" ;
    dct:description "Imported ontology (import)" ;
    dct:modified "2026-10-25T12:57:40.714570+00:00" ;
    dct:title "Clinical Trials Reference Ontology" ;
    wb:axiom_count "154" ;
    wb:class_count "11" ;
    wb:format "turtle" ;
    wb:ontology_type "user_created" ;
    wb:parse_status "ok" ;
    wb:property_count "26" .

# ── Classes ──────────────────────

:Compound a owl:Class ;
    rdfs:label "Compound" ;
    rdfs:comment "An investigational or comparator drug." ;
    skos:altLabel "Drug",
        "Investigational product" ;
    wb:definedBy <urn:ontology:upload-173f21fe> .

:EfficacyResult a owl:Class ;
    rdfs:label "Efficacy result" ;
    rdfs:comment "A measurement of the primary efficacy endpoint at a visit." ;
    skos:altLabel "Endpoint assessment" ;
    wb:definedBy <urn:ontology:upload-173f21fe> .

:LabResult a owl:Class ;
    rdfs:label "Lab result" ;
    rdfs:comment "A laboratory measurement for a subject at a visit." ;
    skos:altLabel "Laboratory test result" ;
    wb:definedBy <urn:ontology:upload-173f21fe> .

:MedDRATerm a owl:Class ;
    rdfs:label "MedDRA term" ;
    rdfs:comment "A MedDRA preferred term and its system organ class." ;
    wb:definedBy <urn:ontology:upload-173f21fe> .

:ProtocolDeviation a owl:Class ;
    rdfs:label "Protocol deviation" ;
    rdfs:comment "A departure from the study protocol, categorised Major or Minor." ;
    wb:definedBy <urn:ontology:upload-173f21fe> .

:SeriousAdverseEvent a owl:Class ;
    rdfs:label "Serious adverse event" ;
    rdfs:comment "An adverse event that is fatal, life-threatening, requires hospitalisation or is otherwise medically important (is_serious = Y)." ;
    rdfs:subClassOf :AdverseEvent ;
    skos:altLabel "SAE" ;
    wb:definedBy <urn:ontology:upload-173f21fe> .

:Site a owl:Class ;
    rdfs:label "Site" ;
    rdfs:comment "An investigator site that enrols subjects." ;
    skos:altLabel "Investigator site" ;
    wb:definedBy <urn:ontology:upload-173f21fe> .

:Study a owl:Class ;
    rdfs:label "Study" ;
    rdfs:comment "A clinical trial with a protocol, phase and sponsor." ;
    skos:altLabel "Clinical trial",
        "Protocol" ;
    wb:definedBy <urn:ontology:upload-173f21fe> .

:StudyArm a owl:Class ;
    rdfs:label "Study arm" ;
    rdfs:comment "A randomised treatment group within a study." ;
    skos:altLabel "Treatment arm" ;
    wb:definedBy <urn:ontology:upload-173f21fe> .

:Subject a owl:Class ;
    rdfs:label "Subject" ;
    rdfs:comment "A trial participant." ;
    skos:altLabel "Participant",
        "Patient" ;
    wb:definedBy <urn:ontology:upload-173f21fe> .

:AdverseEvent a owl:Class ;
    rdfs:label "Adverse event" ;
    rdfs:comment "An untoward medical occurrence in a subject during a study." ;
    skos:altLabel "AE",
        "Side effect" ;
    wb:definedBy <urn:ontology:upload-173f21fe> .

# ── Object properties ──────────────────────

:armUsesCompound a rdf:Property,
        owl:ObjectProperty ;
    rdfs:label "arm uses compound" ;
    rdfs:domain :StudyArm ;
    rdfs:range :Compound ;
    wb:definedBy <urn:ontology:upload-173f21fe> .

:codedAs a rdf:Property,
        owl:ObjectProperty ;
    rdfs:label "coded as" ;
    rdfs:domain :AdverseEvent ;
    rdfs:range :MedDRATerm ;
    wb:definedBy <urn:ontology:upload-173f21fe> .

:deviationOf a rdf:Property,
        owl:ObjectProperty ;
    rdfs:label "deviation of" ;
    rdfs:domain :ProtocolDeviation ;
    rdfs:range :Subject ;
    wb:definedBy <urn:ontology:upload-173f21fe> .

:efficacyOf a rdf:Property,
        owl:ObjectProperty ;
    rdfs:label "efficacy of" ;
    rdfs:domain :EfficacyResult ;
    rdfs:range :Subject ;
    wb:definedBy <urn:ontology:upload-173f21fe> .

:enrolledAtSite a rdf:Property,
        owl:ObjectProperty ;
    rdfs:label "enrolled at site" ;
    rdfs:domain :Subject ;
    rdfs:range :Site ;
    wb:definedBy <urn:ontology:upload-173f21fe> .

:experiencedBy a rdf:Property,
        owl:ObjectProperty ;
    rdfs:label "experienced by" ;
    rdfs:domain :AdverseEvent ;
    rdfs:range :Subject ;
    wb:definedBy <urn:ontology:upload-173f21fe> .

:hasArm a rdf:Property,
        owl:ObjectProperty ;
    rdfs:label "has arm" ;
    rdfs:domain :Study ;
    rdfs:range :StudyArm ;
    wb:definedBy <urn:ontology:upload-173f21fe> .

:hasSite a rdf:Property,
        owl:ObjectProperty ;
    rdfs:label "has site" ;
    rdfs:domain :Study ;
    rdfs:range :Site ;
    wb:definedBy <urn:ontology:upload-173f21fe> .

:labOf a rdf:Property,
        owl:ObjectProperty ;
    rdfs:label "lab of" ;
    rdfs:domain :LabResult ;
    rdfs:range :Subject ;
    wb:definedBy <urn:ontology:upload-173f21fe> .

:participatesIn a rdf:Property,
        owl:ObjectProperty ;
    rdfs:label "participates in" ;
    rdfs:domain :Subject ;
    rdfs:range :Study ;
    wb:definedBy <urn:ontology:upload-173f21fe> .

:randomisedToArm a rdf:Property,
        owl:ObjectProperty ;
    rdfs:label "randomised to arm" ;
    rdfs:domain :Subject ;
    rdfs:range :StudyArm ;
    wb:definedBy <urn:ontology:upload-173f21fe> .

:studiesCompound a rdf:Property,
        owl:ObjectProperty ;
    rdfs:label "studies compound" ;
    rdfs:domain :Study ;
    rdfs:range :Compound ;
    wb:definedBy <urn:ontology:upload-173f21fe> .

# ── Datatype properties ──────────────────────

:age a rdf:Property,
        owl:DatatypeProperty ;
    rdfs:label "age" ;
    rdfs:domain :Subject ;
    rdfs:range xsd:integer ;
    wb:definedBy <urn:ontology:upload-173f21fe> .

:drugName a rdf:Property,
        owl:DatatypeProperty ;
    rdfs:label "drug name" ;
    rdfs:domain :Compound ;
    rdfs:range xsd:string ;
    wb:definedBy <urn:ontology:upload-173f21fe> .

:efficacyValue a rdf:Property,
        owl:DatatypeProperty ;
    rdfs:label "efficacy value" ;
    rdfs:domain :EfficacyResult ;
    rdfs:range xsd:double ;
    wb:definedBy <urn:ontology:upload-173f21fe> .

:indication a rdf:Property,
        owl:DatatypeProperty ;
    rdfs:label "indication" ;
    rdfs:domain :Study ;
    rdfs:range xsd:string ;
    wb:definedBy <urn:ontology:upload-173f21fe> .

:isSerious a rdf:Property,
        owl:DatatypeProperty ;
    rdfs:label "is serious" ;
    rdfs:domain :AdverseEvent ;
    rdfs:range xsd:string ;
    wb:definedBy <urn:ontology:upload-173f21fe> .

:mechanismOfAction a rdf:Property,
        owl:DatatypeProperty ;
    rdfs:label "mechanism of action" ;
    rdfs:domain :Compound ;
    rdfs:range xsd:string ;
    wb:definedBy <urn:ontology:upload-173f21fe> .

:phase a rdf:Property,
        owl:DatatypeProperty ;
    rdfs:label "phase" ;
    rdfs:domain :Study ;
    rdfs:range xsd:string ;
    wb:definedBy <urn:ontology:upload-173f21fe> .

:plannedEnrollment a rdf:Property,
        owl:DatatypeProperty ;
    rdfs:label "planned enrollment" ;
    rdfs:domain :Study ;
    rdfs:range xsd:integer ;
    wb:definedBy <urn:ontology:upload-173f21fe> .

:preferredTerm a rdf:Property,
        owl:DatatypeProperty ;
    rdfs:label "preferred term" ;
    rdfs:domain :AdverseEvent ;
    rdfs:range xsd:string ;
    wb:definedBy <urn:ontology:upload-173f21fe> .

:resultValue a rdf:Property,
        owl:DatatypeProperty ;
    rdfs:label "result value" ;
    rdfs:domain :LabResult ;
    rdfs:range xsd:double ;
    wb:definedBy <urn:ontology:upload-173f21fe> .

:severity a rdf:Property,
        owl:DatatypeProperty ;
    rdfs:label "severity" ;
    rdfs:domain :AdverseEvent ;
    rdfs:range xsd:string ;
    wb:definedBy <urn:ontology:upload-173f21fe> .

:sex a rdf:Property,
        owl:DatatypeProperty ;
    rdfs:label "sex" ;
    rdfs:domain :Subject ;
    rdfs:range xsd:string ;
    wb:definedBy <urn:ontology:upload-173f21fe> .

:studyId a rdf:Property,
        owl:DatatypeProperty ;
    rdfs:label "study id" ;
    rdfs:domain :Study ;
    rdfs:range xsd:string ;
    wb:definedBy <urn:ontology:upload-173f21fe> .

:therapeuticArea a rdf:Property,
        owl:DatatypeProperty ;
    rdfs:label "therapeutic area" ;
    rdfs:domain :Study ;
    rdfs:range xsd:string ;
    wb:definedBy <urn:ontology:upload-173f21fe> .
