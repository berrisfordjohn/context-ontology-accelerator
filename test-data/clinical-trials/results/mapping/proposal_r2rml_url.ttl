@prefix ind: <http://example.org/clinical-trials/> .
@prefix rr: <http://www.w3.org/ns/r2rml#> .
@prefix scl: <http://coa.amazon.com/vocab/coa#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ind:TriplesMap_AdverseEvents a rr:TriplesMap ;
    scl:datasourceId "<GLUE_SOURCE_ID>" ;
    scl:sourceSchema "clinical_trials" ;
    rr:logicalTable [ rr:tableName "\"adverse_events\"" ] ;
    rr:predicateObjectMap <http://example.org/clinical-trials/TriplesMap_AdverseEvents/POM_AeId>,
        <http://example.org/clinical-trials/TriplesMap_AdverseEvents/POM_EndDate>,
        <http://example.org/clinical-trials/TriplesMap_AdverseEvents/POM_IsRelatedToTreatment>,
        <http://example.org/clinical-trials/TriplesMap_AdverseEvents/POM_IsSerious>,
        <http://example.org/clinical-trials/TriplesMap_AdverseEvents/POM_MeddraPtCode>,
        <http://example.org/clinical-trials/TriplesMap_AdverseEvents/POM_Outcome>,
        <http://example.org/clinical-trials/TriplesMap_AdverseEvents/POM_PreferredTerm>,
        <http://example.org/clinical-trials/TriplesMap_AdverseEvents/POM_Severity>,
        <http://example.org/clinical-trials/TriplesMap_AdverseEvents/POM_StartDate>,
        <http://example.org/clinical-trials/TriplesMap_AdverseEvents/POM_StudyId>,
        <http://example.org/clinical-trials/TriplesMap_AdverseEvents/POM_SubjectId>,
        <http://example.org/clinical-trials/TriplesMap_AdverseEvents/POM_SystemOrganClass> ;
    rr:subjectMap <http://example.org/clinical-trials/TriplesMap_AdverseEvents/SubjectMap> .

ind:TriplesMap_EfficacyResults a rr:TriplesMap ;
    scl:datasourceId "<GLUE_SOURCE_ID>" ;
    scl:sourceSchema "clinical_trials" ;
    rr:logicalTable [ rr:tableName "\"efficacy_results\"" ] ;
    rr:predicateObjectMap <http://example.org/clinical-trials/TriplesMap_EfficacyResults/POM_AssessmentDate>,
        <http://example.org/clinical-trials/TriplesMap_EfficacyResults/POM_EfficacyId>,
        <http://example.org/clinical-trials/TriplesMap_EfficacyResults/POM_EndpointName>,
        <http://example.org/clinical-trials/TriplesMap_EfficacyResults/POM_IsBaseline>,
        <http://example.org/clinical-trials/TriplesMap_EfficacyResults/POM_StudyId>,
        <http://example.org/clinical-trials/TriplesMap_EfficacyResults/POM_SubjectId>,
        <http://example.org/clinical-trials/TriplesMap_EfficacyResults/POM_Unit>,
        <http://example.org/clinical-trials/TriplesMap_EfficacyResults/POM_Value>,
        <http://example.org/clinical-trials/TriplesMap_EfficacyResults/POM_Visit> ;
    rr:subjectMap <http://example.org/clinical-trials/TriplesMap_EfficacyResults/SubjectMap> .

ind:TriplesMap_LabResults a rr:TriplesMap ;
    scl:datasourceId "<GLUE_SOURCE_ID>" ;
    scl:sourceSchema "clinical_trials" ;
    rr:logicalTable [ rr:tableName "\"lab_results\"" ] ;
    rr:predicateObjectMap <http://example.org/clinical-trials/TriplesMap_LabResults/POM_AbnormalFlag>,
        <http://example.org/clinical-trials/TriplesMap_LabResults/POM_CollectionDate>,
        <http://example.org/clinical-trials/TriplesMap_LabResults/POM_LabId>,
        <http://example.org/clinical-trials/TriplesMap_LabResults/POM_RefRangeHigh>,
        <http://example.org/clinical-trials/TriplesMap_LabResults/POM_RefRangeLow>,
        <http://example.org/clinical-trials/TriplesMap_LabResults/POM_ResultUnit>,
        <http://example.org/clinical-trials/TriplesMap_LabResults/POM_ResultValue>,
        <http://example.org/clinical-trials/TriplesMap_LabResults/POM_StudyId>,
        <http://example.org/clinical-trials/TriplesMap_LabResults/POM_SubjectId>,
        <http://example.org/clinical-trials/TriplesMap_LabResults/POM_TestCode>,
        <http://example.org/clinical-trials/TriplesMap_LabResults/POM_TestName>,
        <http://example.org/clinical-trials/TriplesMap_LabResults/POM_Visit> ;
    rr:subjectMap <http://example.org/clinical-trials/TriplesMap_LabResults/SubjectMap> .

ind:TriplesMap_ProtocolDeviations a rr:TriplesMap ;
    scl:datasourceId "<GLUE_SOURCE_ID>" ;
    scl:sourceSchema "clinical_trials" ;
    rr:logicalTable [ rr:tableName "\"protocol_deviations\"" ] ;
    rr:predicateObjectMap <http://example.org/clinical-trials/TriplesMap_ProtocolDeviations/POM_Category>,
        <http://example.org/clinical-trials/TriplesMap_ProtocolDeviations/POM_Description>,
        <http://example.org/clinical-trials/TriplesMap_ProtocolDeviations/POM_DeviationDate>,
        <http://example.org/clinical-trials/TriplesMap_ProtocolDeviations/POM_DeviationId>,
        <http://example.org/clinical-trials/TriplesMap_ProtocolDeviations/POM_SiteId>,
        <http://example.org/clinical-trials/TriplesMap_ProtocolDeviations/POM_StudyId>,
        <http://example.org/clinical-trials/TriplesMap_ProtocolDeviations/POM_SubjectId> ;
    rr:subjectMap <http://example.org/clinical-trials/TriplesMap_ProtocolDeviations/SubjectMap> .

<http://example.org/clinical-trials/TriplesMap_AdverseEvents/POM_AeId> rr:objectMap <http://example.org/clinical-trials/TriplesMap_AdverseEvents/POM_AeId/ObjectMap> ;
    rr:predicate ind:adverseEvents_aeId .

<http://example.org/clinical-trials/TriplesMap_AdverseEvents/POM_AeId/ObjectMap> rr:column "\"ae_id\"" ;
    rr:datatype xsd:string .

<http://example.org/clinical-trials/TriplesMap_AdverseEvents/POM_EndDate> rr:objectMap <http://example.org/clinical-trials/TriplesMap_AdverseEvents/POM_EndDate/ObjectMap> ;
    rr:predicate ind:adverseEvents_endDate .

<http://example.org/clinical-trials/TriplesMap_AdverseEvents/POM_EndDate/ObjectMap> rr:column "\"end_date\"" ;
    rr:datatype xsd:date .

<http://example.org/clinical-trials/TriplesMap_AdverseEvents/POM_IsRelatedToTreatment> rr:objectMap <http://example.org/clinical-trials/TriplesMap_AdverseEvents/POM_IsRelatedToTreatment/ObjectMap> ;
    rr:predicate ind:adverseEvents_isRelatedToTreatment .

<http://example.org/clinical-trials/TriplesMap_AdverseEvents/POM_IsRelatedToTreatment/ObjectMap> rr:column "\"is_related_to_treatment\"" ;
    rr:datatype xsd:string .

<http://example.org/clinical-trials/TriplesMap_AdverseEvents/POM_IsSerious> rr:objectMap <http://example.org/clinical-trials/TriplesMap_AdverseEvents/POM_IsSerious/ObjectMap> ;
    rr:predicate ind:adverseEvents_isSerious .

<http://example.org/clinical-trials/TriplesMap_AdverseEvents/POM_IsSerious/ObjectMap> rr:column "\"is_serious\"" ;
    rr:datatype xsd:string .

<http://example.org/clinical-trials/TriplesMap_AdverseEvents/POM_MeddraPtCode> rr:objectMap <http://example.org/clinical-trials/TriplesMap_AdverseEvents/POM_MeddraPtCode/ObjectMap> ;
    rr:predicate ind:adverseEvents_meddraPtCode .

<http://example.org/clinical-trials/TriplesMap_AdverseEvents/POM_MeddraPtCode/ObjectMap> rr:joinCondition [ rr:child "\"meddra_pt_code\"" ;
            rr:parent "\"meddra_pt_code\"" ] ;
    rr:parentTriplesMap ind:TriplesMap_MeddraDictionary .

<http://example.org/clinical-trials/TriplesMap_AdverseEvents/POM_Outcome> rr:objectMap <http://example.org/clinical-trials/TriplesMap_AdverseEvents/POM_Outcome/ObjectMap> ;
    rr:predicate ind:adverseEvents_outcome .

<http://example.org/clinical-trials/TriplesMap_AdverseEvents/POM_Outcome/ObjectMap> rr:column "\"outcome\"" ;
