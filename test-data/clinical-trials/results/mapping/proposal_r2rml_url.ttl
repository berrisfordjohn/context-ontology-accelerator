<http://example.org/clinical-trials/TriplesMap_AdverseEvents/POM_PreferredTerm> rr:objectMap <http://example.org/clinical-trials/TriplesMap_AdverseEvents/POM_PreferredTerm/ObjectMap> ;
    rr:predicate ind:adverseEvents_preferredTerm .

<http://example.org/clinical-trials/TriplesMap_AdverseEvents/POM_PreferredTerm/ObjectMap> rr:column "\"preferred_term\"" ;
    rr:datatype xsd:string .

<http://example.org/clinical-trials/TriplesMap_AdverseEvents/POM_Severity> rr:objectMap <http://example.org/clinical-trials/TriplesMap_AdverseEvents/POM_Severity/ObjectMap> ;
    rr:predicate ind:adverseEvents_severity .

<http://example.org/clinical-trials/TriplesMap_AdverseEvents/POM_Severity/ObjectMap> rr:column "\"severity\"" ;
