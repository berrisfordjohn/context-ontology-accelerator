<http://example.org/clinical-trials/TriplesMap_AdverseEvents/POM_StudyId> rr:objectMap <http://example.org/clinical-trials/TriplesMap_AdverseEvents/POM_StudyId/ObjectMap> ;
    rr:predicate ind:adverseEvents_studyId .

<http://example.org/clinical-trials/TriplesMap_AdverseEvents/POM_StudyId/ObjectMap> rr:joinCondition [ rr:child "\"study_id\"" ;
            rr:parent "\"study_id\"" ] ;
    rr:parentTriplesMap ind:TriplesMap_Studies .

<http://example.org/clinical-trials/TriplesMap_AdverseEvents/POM_SubjectId> rr:objectMap <http://example.org/clinical-trials/TriplesMap_AdverseEvents/POM_SubjectId/ObjectMap> ;
    rr:predicate ind:adverseEvents_subjectId .

<http://example.org/clinical-trials/TriplesMap_AdverseEvents/POM_SubjectId/ObjectMap> rr:joinCondition [ rr:child "\"subject_id\"" ;
            rr:parent "\"subject_id\"" ] ;
    rr:parentTriplesMap ind:TriplesMap_Subjects .

<http://example.org/clinical-trials/TriplesMap_AdverseEvents/POM_SystemOrganClass> rr:objectMap <http://example.org/clinical-trials/TriplesMap_AdverseEvents/POM_SystemOrganClass/ObjectMap> ;
