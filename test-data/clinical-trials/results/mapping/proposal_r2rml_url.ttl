    rr:subjectMap <http://example.org/clinical-trials/TriplesMap_Subjects/SubjectMap> .

ind:TriplesMap_Studies a rr:TriplesMap ;
    scl:datasourceId "<GLUE_SOURCE_ID>" ;
    scl:sourceSchema "clinical_trials" ;
    rr:logicalTable [ rr:tableName "\"studies\"" ] ;
    rr:predicateObjectMap <http://example.org/clinical-trials/TriplesMap_Studies/POM_DrugId>,
        <http://example.org/clinical-trials/TriplesMap_Studies/POM_EndpointUnit>,
        <http://example.org/clinical-trials/TriplesMap_Studies/POM_Indication>,
        <http://example.org/clinical-trials/TriplesMap_Studies/POM_NctId>,
        <http://example.org/clinical-trials/TriplesMap_Studies/POM_Phase>,
        <http://example.org/clinical-trials/TriplesMap_Studies/POM_PlannedEnrollment>,
        <http://example.org/clinical-trials/TriplesMap_Studies/POM_PrimaryEndpoint>,
        <http://example.org/clinical-trials/TriplesMap_Studies/POM_Sponsor>,
        <http://example.org/clinical-trials/TriplesMap_Studies/POM_StartDate>,
        <http://example.org/clinical-trials/TriplesMap_Studies/POM_Status>,
        <http://example.org/clinical-trials/TriplesMap_Studies/POM_StudyId>,
        <http://example.org/clinical-trials/TriplesMap_Studies/POM_TherapeuticArea>,
        <http://example.org/clinical-trials/TriplesMap_Studies/POM_Title> ;
    rr:subjectMap <http://example.org/clinical-trials/TriplesMap_Studies/SubjectMap> .

