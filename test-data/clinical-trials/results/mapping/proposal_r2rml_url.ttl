<http://example.org/clinical-trials/TriplesMap_AdverseEvents/POM_StartDate> rr:objectMap <http://example.org/clinical-trials/TriplesMap_AdverseEvents/POM_StartDate/ObjectMap> ;
    rr:predicate ind:adverseEvents_startDate .

<http://example.org/clinical-trials/TriplesMap_AdverseEvents/POM_StartDate/ObjectMap> rr:column "\"start_date\"" ;
