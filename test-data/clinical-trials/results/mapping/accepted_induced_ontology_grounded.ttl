@prefix dct: <http://purl.org/dc/terms/> .
@prefix neptune: <http://aws.amazon.com/neptune/vocab/v01/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix wb: <https://ontology-workbench.local/vocab#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# ── Ontology ──────────────────────

<http://example.org/clinical-trials> a owl:Ontology ;
    rdfs:label "Proposal Ontology" .

: a owl:Ontology ;
    dct:created "2026-10-25T12:58:58.769123+00:00" ;
    dct:description "Accepted from proposal 77ccd903-b051-490b-893e-2846a284bd63" ;
    dct:modified "2026-10-25T12:58:58.769123+00:00" ;
    dct:title "clinical-trials induction (grounded)" ;
    wb:axiom_count "1518" ;
    wb:class_count "10" ;
    wb:domainTag "induced" ;
    wb:file_path "./data/ontologies/http___example.org_clinical-trials_.ttl" ;
    wb:format "turtle" ;
    wb:ontology_type "induced" ;
    wb:parse_status "ok" ;
    wb:property_count "91" .

# ── Classes ──────────────────────

:AdverseEvents a owl:Class ;
    rdfs:label "adverse_events" ;
    coa:glossaryTerm "MedDRA",
        "adverse event",
        "pharmacovigilance",
        "serious adverse event",
        "system organ class" ;
    coa:isMapped true ;
    coa:tag "clinical_trials",
        "pharmacovigilance",
        "safety",
        "synthetic_data",
        "test" ;
    :matchConfidence "0.97"^^xsd:float ;
    rdfs:comment "Records of adverse events (AEs) experienced by study subjects during clinical trials, capturing safety data including event classification, severity, relationship to treatment, and outcome. Used for pharmacovigilance and regulatory safety reporting." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty :adverseEvents_aeId ],
        <https://example.org/ontology/clinical-trials#AdverseEvent> ;
    owl:hasKey ( :adverseEvents_aeId ) ;
    skos:altLabel "AE",
        "adverse event log",
        "safety events",
        "side effects log" ;
    skos:exactMatch <https://example.org/ontology/clinical-trials#AdverseEvent> ;
    wb:definedBy : .

:Compounds a owl:Class ;
    rdfs:label "compounds" ;
    coa:glossaryTerm "ATC code",
        "INN",
        "drug class",
        "mechanism of action",
        "pharmacology" ;
    coa:isMapped true ;
    coa:tag "clinical trials",
        "drug registry",
        "pharmacology",
        "reference data",
        "test data" ;
    :matchConfidence "0.97"^^xsd:float ;
    rdfs:comment "Reference catalog of pharmaceutical compounds and investigational drugs used in clinical trials, capturing key pharmacological properties including drug classification, mechanism of action, molecular target, and standardized coding." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty :compounds_drugId ],
        <https://example.org/ontology/clinical-trials#Compound> ;
    owl:hasKey ( :compounds_drugId ) ;
    skos:altLabel "drug catalog",
        "drugs",
        "investigational drugs",
        "pharmaceutical compounds" ;
    skos:exactMatch <https://example.org/ontology/clinical-trials#Compound> ;
    wb:definedBy : .

:EfficacyResults a owl:Class ;
    rdfs:label "efficacy_results" ;
    coa:glossaryTerm "baseline measurement",
        "clinical trial",
        "efficacy endpoint",
        "outcome assessment",
        "study visit" ;
    coa:isMapped true ;
    coa:tag "clinical-trials",
        "efficacy",
        "outcomes",
        "synthetic-data",
        "test" ;
    :matchConfidence "0.97"^^xsd:float ;
    rdfs:comment "Stores efficacy measurement results for subjects enrolled in clinical trials, capturing endpoint assessments across study visits. Each record represents a single efficacy measurement for a subject at a specific visit, including baseline and follow-up evaluations used to assess treatment effectiveness." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty :efficacyResults_efficacyId ],
        <https://example.org/ontology/clinical-trials#EfficacyResult> ;
    owl:hasKey ( :efficacyResults_efficacyId ) ;
    skos:altLabel "clinical outcomes data",
        "efficacy assessments",
        "endpoint results",
        "trial outcomes" ;
    skos:exactMatch <https://example.org/ontology/clinical-trials#EfficacyResult> ;
    wb:definedBy : .

:LabResults a owl:Class ;
    rdfs:label "lab_results" ;
    coa:glossaryTerm "abnormal flag",
        "biomarker",
        "clinical trial safety data",
        "laboratory results",
        "reference range" ;
    coa:isMapped true ;
    coa:tag "clinical_trials",
        "laboratory",
        "safety",
        "subject_data",
        "synthetic_test" ;
    :matchConfidence "0.99"^^xsd:float ;
    rdfs:comment "Laboratory test results collected from clinical trial subjects across study visits. Each record captures a single lab measurement for a participant, including the test performed, the numeric result, reference range boundaries, and an abnormality flag indicating whether the result falls outside normal limits. Used to monitor subject safety and evaluate clinical endpoints during trial conduct." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty :labResults_labId ],
        <https://example.org/ontology/clinical-trials#LabResult> ;
    owl:hasKey ( :labResults_labId ) ;
    skos:altLabel "clinical lab results",
        "lab data",
        "lab measurements",
        "laboratory findings" ;
    skos:exactMatch <https://example.org/ontology/clinical-trials#LabResult> ;
    wb:definedBy : .

:MeddraDictionary a owl:Class ;
    rdfs:label "meddra_dictionary" ;
    coa:glossaryTerm "Adverse Event Coding",
        "MedDRA",
        "Preferred Term",
        "Regulatory Terminology",
        "System Organ Class" ;
    coa:isMapped true ;
    coa:tag "clinical_trials",
        "meddra",
        "medical_coding",
        "reference_data",
        "regulatory" ;
    :matchConfidence "0.98"^^xsd:float ;
    rdfs:comment "MedDRA (Medical Dictionary for Regulatory Activities) reference dictionary used in clinical trials to standardize the coding of adverse events, diagnoses, and medical conditions. Maps preferred terms and their associated codes to system organ classes for regulatory reporting purposes." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty :meddraDictionary_meddraPtCode ],
        <https://example.org/ontology/clinical-trials#MedDRATerm> ;
    owl:hasKey ( :meddraDictionary_meddraPtCode ) ;
    skos:altLabel "Adverse Event Dictionary",
        "MedDRA Lookup",
        "MedDRA Reference",
        "Medical Dictionary" ;
    skos:exactMatch <https://example.org/ontology/clinical-trials#MedDRATerm> ;
    wb:definedBy : .

:ProtocolDeviations a owl:Class ;
    rdfs:label "protocol_deviations" ;
    coa:glossaryTerm "GCP compliance",
        "clinical trial monitoring",
        "protocol deviation",
        "regulatory compliance",
        "subject safety" ;
    coa:isMapped true ;
    coa:tag "clinical_trials",
        "compliance",
        "quality_assurance",
        "regulatory",
        "test_data" ;
    :matchConfidence "0.98"^^xsd:float ;
    rdfs:comment "Records protocol deviations identified during clinical trials, capturing instances where study procedures deviated from the approved protocol for a given subject, site, and study. Used for regulatory compliance tracking, quality assurance, and risk management in clinical trial operations." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty :protocolDeviations_deviationId ],
        <https://example.org/ontology/clinical-trials#ProtocolDeviation> ;
    owl:hasKey ( :protocolDeviations_deviationId ) ;
    skos:altLabel "GCP deviations",
        "protocol violations",
        "study deviations",
        "trial deviations" ;
    skos:exactMatch <https://example.org/ontology/clinical-trials#ProtocolDeviation> ;
    wb:definedBy : .

:Sites a owl:Class ;
    rdfs:label "sites" ;
    coa:glossaryTerm "GCP site",
        "clinical trial site",
        "investigational site",
        "principal investigator",
        "site activation" ;
    coa:isMapped true ;
    coa:tag "clinical-trials",
        "operations",
        "sites",
        "synthetic",
        "test-data" ;
    :matchConfidence "0.97"^^xsd:float ;
    rdfs:comment "Represents individual investigational sites participating in clinical trials, capturing location details, responsible investigator, and operational status for each site-study pairing." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty :sites_siteId ],
        <https://example.org/ontology/clinical-trials#Site> ;
    owl:hasKey ( :sites_siteId ) ;
    skos:altLabel "clinical sites",
        "investigational sites",
        "study sites",
        "trial sites" ;
    skos:exactMatch <https://example.org/ontology/clinical-trials#Site> ;
    wb:definedBy : .

:Studies a owl:Class ;
    rdfs:label "studies" ;
    coa:glossaryTerm "NCT number",
        "clinical trial",
        "investigational drug",
        "primary endpoint",
        "study enrollment",
        "study phase",
        "therapeutic area" ;
    coa:isMapped true ;
    coa:tag "clinical trials",
        "drug development",
        "regulatory",
        "research",
        "synthetic data" ;
    :matchConfidence "0.98"^^xsd:float ;
    rdfs:comment "Stores records for clinical trial studies, capturing key protocol details such as phase, therapeutic area, indication, sponsoring organization, enrollment targets, and primary endpoints. Each study is identified by an internal study ID and linked to a ClinicalTrials.gov NCT identifier. This is synthetic test data." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty :studies_studyId ],
        <https://example.org/ontology/clinical-trials#Study> ;
    owl:hasKey ( :studies_studyId ) ;
    skos:altLabel "CT studies",
        "clinical studies",
        "study protocol records",
        "trials registry" ;
    skos:exactMatch <https://example.org/ontology/clinical-trials#Study> ;
    wb:definedBy : .

:StudyArms a owl:Class ;
    rdfs:label "study_arms" ;
    coa:glossaryTerm "clinical trial arm",
        "dose assignment",
        "intervention group",
        "randomized controlled trial",
        "treatment group" ;
    coa:isMapped true ;
    coa:tag "clinical_trials",
        "interventions",
        "study_design",
        "synthetic_data",
        "test" ;
    :matchConfidence "0.98"^^xsd:float ;
    rdfs:comment "Represents the individual arms (groups) within a clinical trial study, defining how participants are divided and treated. Each arm specifies the intervention type, associated drug, and dosage used for that group of participants." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty :studyArms_armId ],
        <https://example.org/ontology/clinical-trials#StudyArm> ;
    owl:hasKey ( :studyArms_armId ) ;
    skos:altLabel "cohort arms",
        "study groups",
        "treatment arms",
        "trial arms" ;
    skos:exactMatch <https://example.org/ontology/clinical-trials#StudyArm> ;
    wb:definedBy : .

:Subjects a owl:Class ;
    rdfs:label "subjects" ;
    coa:glossaryTerm "discontinuation",
        "enrollment",
        "informed consent",
        "randomization",
        "subject",
        "treatment arm" ;
    coa:isMapped true ;
    coa:tag "clinical trials",
        "demographics",
        "enrollment",
        "participants",
        "synthetic/test" ;
    :matchConfidence "0.98"^^xsd:float ;
    rdfs:comment "Stores demographic and enrollment information for individual participants (subjects) enrolled in clinical trials. Each record represents a single subject assigned to a study site and treatment arm, capturing consent, randomization, and study completion or discontinuation details." ;
    rdfs:subClassOf [ a owl:Restriction ;
            owl:cardinality "1"^^xsd:nonNegativeInteger ;
            owl:onProperty :subjects_subjectId ],
        <https://example.org/ontology/clinical-trials#Subject> ;
    owl:hasKey ( :subjects_subjectId ) ;
    skos:altLabel "clinical study participants",
        "enrolled patients",
        "study subjects",
        "trial participants" ;
    skos:exactMatch <https://example.org/ontology/clinical-trials#Subject> ;
    wb:definedBy : .

# ── Object properties ──────────────────────

:adverseEvents_meddraPtCode a rdf:Property,
        owl:ObjectProperty ;
    rdfs:label "meddra_pt_code" ;
    coa:fkProvenance "AI_INFERRED" ;
    coa:glossaryTerm "MedDRA",
        "preferred term code" ;
    coa:tag "MedDRA",
        "classification",
        "code" ;
    rdfs:comment "The numeric MedDRA code corresponding to the Preferred Term, enabling standardized coding of the adverse event for regulatory submissions. (Foreign key: adverse_events.meddra_pt_code references meddra_dictionary.meddra_pt_code)" ;
    rdfs:domain :AdverseEvents ;
    rdfs:range :MeddraDictionary ;
    skos:altLabel "MedDRA code",
        "PT code",
        "event code" ;
    wb:definedBy : .

:adverseEvents_studyId a rdf:Property,
        owl:ObjectProperty ;
    rdfs:label "study_id" ;
    coa:fkProvenance "AI_INFERRED" ;
    coa:glossaryTerm "clinical study",
        "clinical trial protocol" ;
    coa:tag "identifier",
        "study" ;
    rdfs:comment "Identifier for the clinical study or trial in which the adverse event was observed, used to associate the event with a specific protocol. (Foreign key: adverse_events.study_id references studies.study_id)" ;
    rdfs:domain :AdverseEvents ;
    rdfs:range :Studies ;
    skos:altLabel "protocol ID",
        "study identifier",
        "trial ID" ;
    wb:definedBy : .

:adverseEvents_subjectId a rdf:Property,
        owl:ObjectProperty ;
    rdfs:label "subject_id" ;
    coa:fkProvenance "AI_INFERRED" ;
    coa:glossaryTerm "study participant",
        "trial subject" ;
    coa:tag "identifier",
        "subject" ;
    rdfs:comment "Identifier for the trial subject (patient) who experienced the adverse event, used to link events to a specific participant. (Foreign key: adverse_events.subject_id references subjects.subject_id)" ;
    rdfs:domain :AdverseEvents ;
    rdfs:range :Subjects ;
    skos:altLabel "participant ID",
        "patient ID",
        "subject identifier" ;
    wb:definedBy : .

:efficacyResults_studyId a rdf:Property,
        owl:ObjectProperty ;
    rdfs:label "study_id" ;
    coa:fkProvenance "AI_INFERRED" ;
    coa:glossaryTerm "clinical study",
        "study identifier",
        "trial protocol" ;
    coa:tag "foreign-key-candidate",
        "identifier",
        "study" ;
    rdfs:comment "Identifier for the clinical study or trial to which this efficacy result belongs. (Foreign key: efficacy_results.study_id references studies.study_id)" ;
    rdfs:domain :EfficacyResults ;
    rdfs:range :Studies ;
    skos:altLabel "protocol ID",
        "study number",
        "trial ID" ;
    wb:definedBy : .

:efficacyResults_subjectId a rdf:Property,
        owl:ObjectProperty ;
    rdfs:label "subject_id" ;
    coa:fkProvenance "AI_INFERRED" ;
    coa:glossaryTerm "patient identifier",
        "study participant",
        "trial subject" ;
    coa:tag "foreign-key-candidate",
        "identifier",
        "subject" ;
    rdfs:comment "Identifier for the trial participant or subject whose efficacy data is being recorded. (Foreign key: efficacy_results.subject_id references subjects.subject_id)" ;
    rdfs:domain :EfficacyResults ;
    rdfs:range :Subjects ;
    skos:altLabel "participant ID",
        "patient ID",
        "subject number" ;
    wb:definedBy : .

:labResults_studyId a rdf:Property,
        owl:ObjectProperty ;
    rdfs:label "study_id" ;
    coa:fkProvenance "AI_INFERRED" ;
    coa:glossaryTerm "clinical study",
        "study identifier",
        "trial protocol" ;
    coa:tag "clinical_trials",
        "identifier",
