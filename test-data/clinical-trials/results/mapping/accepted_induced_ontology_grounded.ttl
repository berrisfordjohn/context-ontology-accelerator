:protocolDeviations_siteId a rdf:Property,
        owl:ObjectProperty ;
    rdfs:label "site_id" ;
    coa:fkProvenance "AI_INFERRED" ;
    coa:glossaryTerm "clinical site",
        "investigative site",
        "trial site" ;
    coa:tag "foreign_key",
        "identifier",
        "site" ;
