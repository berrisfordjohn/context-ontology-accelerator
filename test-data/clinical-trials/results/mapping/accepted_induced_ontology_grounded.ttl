# ── Datatype properties ──────────────────────

:adverseEvents_aeId a rdf:Property,
        owl:DatatypeProperty ;
    rdfs:label "ae_id" ;
    coa:glossaryTerm "adverse event" ;
    coa:tag "identifier",
        "primary_key" ;
    rdfs:comment "Unique identifier for each adverse event record within the clinical trial safety database." ;
    rdfs:domain :AdverseEvents ;
    rdfs:range xsd:string ;
    skos:altLabel "AE identifier",
        "adverse event ID" ;
    wb:definedBy : .

:adverseEvents_endDate a rdf:Property,
        owl:DatatypeProperty ;
    rdfs:label "end_date" ;
    coa:glossaryTerm "adverse event resolution" ;
    coa:tag "date",
        "temporal" ;
    rdfs:comment "The date on which the adverse event resolved or ended; may be null if the event is ongoing or outcome is unknown." ;
    rdfs:domain :AdverseEvents ;
    rdfs:range xsd:date ;
    skos:altLabel "AE resolution date",
        "event end date",
