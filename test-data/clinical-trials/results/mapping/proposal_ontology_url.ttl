@prefix ind: <http://example.org/clinical-trials/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix scl: <http://coa.amazon.com/vocab/coa#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/clinical-trials> a owl:Ontology ;
    rdfs:label "Proposal Ontology" .

ind:adverseEvents_endDate a owl:DatatypeProperty ;
    rdfs:label "end_date" ;
    scl:glossaryTerm "adverse event resolution" ;
    scl:tag "date",
        "temporal" ;
    rdfs:comment "The date on which the adverse event resolved or ended; may be null if the event is ongoing or outcome is unknown." ;
    rdfs:domain ind:AdverseEvents ;
    rdfs:range xsd:date ;
    skos:altLabel "AE resolution date",
        "event end date",
        "resolution date" .

ind:adverseEvents_isRelatedToTreatment a owl:DatatypeProperty ;
    rdfs:label "is_related_to_treatment" ;
    scl:glossaryTerm "adverse event relatedness",
        "causality assessment",
        "treatment relationship" ;
    scl:tag "causality",
        "flag",
        "safety" ;
    rdfs:comment "Flag indicating the investigator's assessment of whether the adverse event is causally related to the study treatment or intervention." ;
    rdfs:domain ind:AdverseEvents ;
    rdfs:range xsd:string ;
    skos:altLabel "causality flag",
        "relatedness flag",
        "treatment-related indicator" .

ind:adverseEvents_isSerious a owl:DatatypeProperty ;
    rdfs:label "is_serious" ;
    scl:glossaryTerm "SAE",
        "pharmacovigilance",
        "serious adverse event" ;
    scl:tag "SAE",
        "flag",
        "safety" ;
    rdfs:comment "Flag indicating whether the adverse event meets regulatory criteria for a Serious Adverse Event (SAE), such as hospitalization, life-threatening condition, or death." ;
    rdfs:domain ind:AdverseEvents ;
    rdfs:range xsd:string ;
    skos:altLabel "SAE flag",
        "serious AE indicator",
        "seriousness flag" .

ind:adverseEvents_meddraPtCode a owl:ObjectProperty ;
    rdfs:label "meddra_pt_code" ;
    scl:fkProvenance "AI_INFERRED" ;
    scl:glossaryTerm "MedDRA",
        "preferred term code" ;
    scl:tag "MedDRA",
        "classification",
        "code" ;
    rdfs:comment "The numeric MedDRA code corresponding to the Preferred Term, enabling standardized coding of the adverse event for regulatory submissions. (Foreign key: adverse_events.meddra_pt_code references meddra_dictionary.meddra_pt_code)" ;
    rdfs:domain ind:AdverseEvents ;
    rdfs:range ind:MeddraDictionary ;
    skos:altLabel "MedDRA code",
        "PT code",
        "event code" .

ind:adverseEvents_outcome a owl:DatatypeProperty ;
    rdfs:label "outcome" ;
    scl:glossaryTerm "adverse event outcome",
        "safety outcome" ;
    scl:tag "outcome",
        "safety",
        "status" ;
    rdfs:comment "The final outcome or status of the adverse event (e.g., Recovered, Recovering, Not Recovered, Fatal, Unknown), used in safety narratives and regulatory reports." ;
    rdfs:domain ind:AdverseEvents ;
    rdfs:range xsd:string ;
    skos:altLabel "AE outcome",
        "event resolution status",
        "resolution outcome" .

ind:adverseEvents_preferredTerm a owl:DatatypeProperty ;
    rdfs:label "preferred_term" ;
    scl:glossaryTerm "MedDRA",
        "adverse event classification",
        "preferred term" ;
    scl:tag "MedDRA",
        "classification",
        "terminology" ;
    rdfs:comment "The standardized MedDRA Preferred Term (PT) used to classify and describe the adverse event in a consistent, regulatory-compliant terminology." ;
    rdfs:domain ind:AdverseEvents ;
    rdfs:range xsd:string ;
    skos:altLabel "MedDRA preferred term",
        "PT",
        "event term" .

ind:adverseEvents_severity a owl:DatatypeProperty ;
    rdfs:label "severity" ;
    scl:glossaryTerm "CTCAE grade",
        "adverse event severity",
        "severity grading" ;
    scl:tag "grading",
        "safety",
        "severity" ;
    rdfs:comment "The intensity or grade of the adverse event (e.g., Mild, Moderate, Severe), typically aligned with CTCAE or similar grading scales." ;
    rdfs:domain ind:AdverseEvents ;
    rdfs:range xsd:string ;
    skos:altLabel "AE grade",
        "grade",
        "intensity" .

ind:adverseEvents_startDate a owl:DatatypeProperty ;
    rdfs:label "start_date" ;
    scl:glossaryTerm "adverse event onset" ;
    scl:tag "date",
        "temporal" ;
    rdfs:comment "The date on which the adverse event began or was first observed for the subject." ;
    rdfs:domain ind:AdverseEvents ;
    rdfs:range xsd:date ;
    skos:altLabel "AE onset date",
        "event start date",
        "onset date" .

ind:adverseEvents_studyId a owl:ObjectProperty ;
    rdfs:label "study_id" ;
    scl:fkProvenance "AI_INFERRED" ;
    scl:glossaryTerm "clinical study",
        "clinical trial protocol" ;
    scl:tag "identifier",
        "study" ;
    rdfs:comment "Identifier for the clinical study or trial in which the adverse event was observed, used to associate the event with a specific protocol. (Foreign key: adverse_events.study_id references studies.study_id)" ;
    rdfs:domain ind:AdverseEvents ;
    rdfs:range ind:Studies ;
    skos:altLabel "protocol ID",
        "study identifier",
        "trial ID" .

ind:adverseEvents_subjectId a owl:ObjectProperty ;
    rdfs:label "subject_id" ;
    scl:fkProvenance "AI_INFERRED" ;
    scl:glossaryTerm "study participant",
        "trial subject" ;
    scl:tag "identifier",
        "subject" ;
    rdfs:comment "Identifier for the trial subject (patient) who experienced the adverse event, used to link events to a specific participant. (Foreign key: adverse_events.subject_id references subjects.subject_id)" ;
    rdfs:domain ind:AdverseEvents ;
    rdfs:range ind:Subjects ;
    skos:altLabel "participant ID",
        "patient ID",
        "subject identifier" .

ind:adverseEvents_systemOrganClass a owl:DatatypeProperty ;
    rdfs:label "system_organ_class" ;
    scl:glossaryTerm "MedDRA",
        "SOC",
        "system organ class" ;
    scl:tag "MedDRA",
        "classification",
        "organ_system" ;
    rdfs:comment "The MedDRA System Organ Class (SOC) that groups the adverse event by the body system or organ most closely associated with it, used for safety signal detection and reporting." ;
    rdfs:domain ind:AdverseEvents ;
    rdfs:range xsd:string ;
    skos:altLabel "SOC",
        "body system",
        "organ class" .

ind:compounds_atcCode a owl:DatatypeProperty ;
    rdfs:label "atc_code" ;
    scl:glossaryTerm "ATC code",
        "Anatomical Therapeutic Chemical",
        "WHO drug classification" ;
    scl:tag "WHO",
        "classification",
        "pharmacology",
        "standardized code" ;
    rdfs:comment "The Anatomical Therapeutic Chemical (ATC) classification code assigned by the WHO, providing a standardized hierarchical classification of the drug based on the organ system it acts on and its therapeutic, pharmacological, and chemical properties." ;
    rdfs:domain ind:Compounds ;
    rdfs:range xsd:string ;
    skos:altLabel "ATC classification",
        "WHO ATC code",
        "drug classification code" .

ind:compounds_drugClass a owl:DatatypeProperty ;
    rdfs:label "drug_class" ;
    scl:glossaryTerm "drug classification",
        "pharmacological grouping",
        "therapeutic category" ;
    scl:tag "classification",
        "pharmacology" ;
    rdfs:comment "The pharmacological or therapeutic class to which the drug belongs, grouping compounds with similar chemical structures or therapeutic uses (e.g., NSAID, beta-blocker, monoclonal antibody)." ;
    rdfs:domain ind:Compounds ;
    rdfs:range xsd:string ;
    skos:altLabel "drug category",
        "pharmacological class",
        "therapeutic class" .

ind:compounds_drugName a owl:DatatypeProperty ;
    rdfs:label "drug_name" ;
    scl:glossaryTerm "brand name",
        "proprietary name" ;
    scl:tag "drug name",
        "label" ;
    rdfs:comment "The proprietary or working name of the drug or compound as used within clinical trial documentation." ;
    rdfs:domain ind:Compounds ;
    rdfs:range xsd:string ;
    skos:altLabel "compound name",
        "drug label",
        "trade name" .

ind:compounds_inn a owl:DatatypeProperty ;
    rdfs:label "inn" ;
    scl:glossaryTerm "INN",
        "International Nonproprietary Name",
        "generic drug name" ;
    scl:tag "WHO",
        "pharmacology",
        "standardized name" ;
    rdfs:comment "International Nonproprietary Name (INN) — the globally recognized generic name assigned to the active pharmaceutical ingredient by the World Health Organization (WHO)." ;
    rdfs:domain ind:Compounds ;
    rdfs:range xsd:string ;
    skos:altLabel "WHO name",
        "generic name",
        "nonproprietary name" .

ind:compounds_mechanismOfAction a owl:DatatypeProperty ;
    rdfs:label "mechanism_of_action" ;
    scl:glossaryTerm "MOA",
        "mechanism of action",
        "pharmacodynamics" ;
    scl:tag "pharmacodynamics",
        "pharmacology" ;
    rdfs:comment "A description of how the drug exerts its therapeutic effect at a biochemical or physiological level, such as enzyme inhibition, receptor agonism, or ion channel blockade." ;
    rdfs:domain ind:Compounds ;
    rdfs:range xsd:string ;
    skos:altLabel "MOA",
        "mode of action",
        "pharmacodynamic mechanism" .

ind:compounds_target a owl:DatatypeProperty ;
    rdfs:label "target" ;
    scl:glossaryTerm "drug target",
        "pharmacological target",
        "receptor" ;
    scl:tag "molecular biology",
        "pharmacology",
        "target" ;
    rdfs:comment "The specific biological molecule, receptor, enzyme, or pathway that the drug interacts with to produce its pharmacological effect (e.g., COX-2, HER2, PD-1)." ;
    rdfs:domain ind:Compounds ;
    rdfs:range xsd:string ;
    skos:altLabel "biological target",
        "drug target",
        "molecular target" .

ind:efficacyResults_assessmentDate a owl:DatatypeProperty ;
    rdfs:label "assessment_date" ;
    scl:glossaryTerm "assessment date",
        "observation date" ;
    scl:tag "date",
        "temporal" ;
    rdfs:comment "The calendar date on which the efficacy measurement or assessment was performed for the subject." ;
    rdfs:domain ind:EfficacyResults ;
    rdfs:range xsd:date ;
    skos:altLabel "evaluation date",
        "measurement date",
        "observation date" .

ind:efficacyResults_endpointName a owl:DatatypeProperty ;
    rdfs:label "endpoint_name" ;
    scl:glossaryTerm "clinical endpoint",
        "outcome measure",
        "primary endpoint",
        "secondary endpoint" ;
    scl:tag "clinical-measure",
        "endpoint" ;
    rdfs:comment "Name or label of the clinical efficacy endpoint being measured, such as a biomarker, symptom score, or disease assessment scale." ;
    rdfs:domain ind:EfficacyResults ;
    rdfs:range xsd:string ;
    skos:altLabel "efficacy measure name",
        "endpoint label",
        "outcome measure" .

ind:efficacyResults_isBaseline a owl:DatatypeProperty ;
    rdfs:label "is_baseline" ;
    scl:glossaryTerm "baseline",
        "pre-treatment measurement",
        "reference value" ;
    scl:tag "baseline",
        "flag",
        "indicator" ;
    rdfs:comment "Flag indicating whether this efficacy measurement represents the baseline assessment taken prior to treatment initiation, used as a reference for evaluating treatment effect." ;
    rdfs:domain ind:EfficacyResults ;
    rdfs:range xsd:string ;
    skos:altLabel "baseline flag",
        "baseline indicator",
        "pre-treatment indicator" .

ind:efficacyResults_studyId a owl:ObjectProperty ;
    rdfs:label "study_id" ;
    scl:fkProvenance "AI_INFERRED" ;
    scl:glossaryTerm "clinical study",
        "study identifier",
        "trial protocol" ;
    scl:tag "foreign-key-candidate",
        "identifier",
        "study" ;
    rdfs:comment "Identifier for the clinical study or trial to which this efficacy result belongs. (Foreign key: efficacy_results.study_id references studies.study_id)" ;
    rdfs:domain ind:EfficacyResults ;
    rdfs:range ind:Studies ;
    skos:altLabel "protocol ID",
        "study number",
        "trial ID" .

ind:efficacyResults_subjectId a owl:ObjectProperty ;
    rdfs:label "subject_id" ;
    scl:fkProvenance "AI_INFERRED" ;
    scl:glossaryTerm "patient identifier",
        "study participant",
        "trial subject" ;
    scl:tag "foreign-key-candidate",
        "identifier",
        "subject" ;
    rdfs:comment "Identifier for the trial participant or subject whose efficacy data is being recorded. (Foreign key: efficacy_results.subject_id references subjects.subject_id)" ;
    rdfs:domain ind:EfficacyResults ;
    rdfs:range ind:Subjects ;
    skos:altLabel "participant ID",
        "patient ID",
        "subject number" .

ind:efficacyResults_unit a owl:DatatypeProperty ;
    rdfs:label "unit" ;
    scl:glossaryTerm "SI unit",
        "unit of measurement" ;
    scl:tag "measurement",
        "unit" ;
    rdfs:comment "The unit of measure associated with the efficacy endpoint value (e.g., mg/dL, score, mm Hg)." ;
    rdfs:domain ind:EfficacyResults ;
    rdfs:range xsd:string ;
    skos:altLabel "measurement unit",
        "result unit",
        "unit of measure" .

ind:efficacyResults_value a owl:DatatypeProperty ;
    rdfs:label "value" ;
    scl:glossaryTerm "efficacy value",
        "endpoint result",
        "observed measurement" ;
    scl:tag "measurement",
        "numeric",
        "result" ;
    rdfs:comment "The numeric result or measured value of the efficacy endpoint for the subject at the given visit." ;
    rdfs:domain ind:EfficacyResults ;
    rdfs:range xsd:double ;
    skos:altLabel "endpoint value",
        "measurement value",
        "observed value",
        "result" .

ind:efficacyResults_visit a owl:DatatypeProperty ;
    rdfs:label "visit" ;
    scl:glossaryTerm "assessment timepoint",
        "protocol visit",
        "study visit" ;
    scl:tag "schedule",
        "timepoint",
        "visit" ;
    rdfs:comment "The scheduled study visit or timepoint at which the efficacy assessment was conducted (e.g., Week 1, Day 28, Follow-up)." ;
    rdfs:domain ind:EfficacyResults ;
    rdfs:range xsd:string ;
    skos:altLabel "study visit",
        "timepoint",
        "visit code",
        "visit name" .

ind:labResults_abnormalFlag a owl:DatatypeProperty ;
    rdfs:label "abnormal_flag" ;
    scl:glossaryTerm "CDISC flag",
        "abnormal result",
        "clinical significance flag" ;
    scl:tag "abnormal",
        "flag",
        "laboratory",
        "safety" ;
    rdfs:comment "A flag indicating whether the lab result is outside the normal reference range, typically coded as 'H' (high), 'L' (low), 'N' (normal), or 'CS' (critically abnormal)." ;
    rdfs:domain ind:LabResults ;
    rdfs:range xsd:string ;
    skos:altLabel "abnormality flag",
        "normal flag",
        "out-of-range flag",
        "result flag" .

ind:labResults_collectionDate a owl:DatatypeProperty ;
    rdfs:label "collection_date" ;
    scl:glossaryTerm "sample date",
        "specimen collection" ;
    scl:tag "collection",
        "date",
        "laboratory" ;
    rdfs:comment "The calendar date on which the biological sample was collected from the subject for laboratory analysis." ;
    rdfs:domain ind:LabResults ;
    rdfs:range xsd:date ;
    skos:altLabel "draw date",
        "sample date",
        "specimen collection date" .

ind:labResults_refRangeHigh a owl:DatatypeProperty ;
    rdfs:label "ref_range_high" ;
    scl:glossaryTerm "ULN",
        "reference range",
        "upper limit of normal" ;
    scl:tag "laboratory",
        "reference_range",
        "threshold" ;
    rdfs:comment "The upper bound of the normal reference range for the laboratory test, above which a result may be flagged as abnormally high." ;
    rdfs:domain ind:LabResults ;
    rdfs:range xsd:double ;
    skos:altLabel "normal high",
        "ref high",
        "upper reference limit" .

ind:labResults_refRangeLow a owl:DatatypeProperty ;
    rdfs:label "ref_range_low" ;
    scl:glossaryTerm "LLN",
        "lower limit of normal",
        "reference range" ;
    scl:tag "laboratory",
        "reference_range",
        "threshold" ;
    rdfs:comment "The lower bound of the normal reference range for the laboratory test, below which a result may be flagged as abnormally low." ;
    rdfs:domain ind:LabResults ;
    rdfs:range xsd:double ;
    skos:altLabel "lower reference limit",
        "normal low",
        "ref low" .

ind:labResults_resultUnit a owl:DatatypeProperty ;
    rdfs:label "result_unit" ;
    scl:glossaryTerm "SI unit",
        "clinical unit",
        "unit of measure" ;
    scl:tag "laboratory",
        "measurement",
        "unit" ;
    rdfs:comment "The unit of measure associated with the laboratory test result value, such as g/dL, mmol/L, or U/L." ;
    rdfs:domain ind:LabResults ;
    rdfs:range xsd:string ;
    skos:altLabel "lab unit",
        "measurement unit",
        "unit" .

ind:labResults_resultValue a owl:DatatypeProperty ;
    rdfs:label "result_value" ;
    scl:glossaryTerm "laboratory result",
        "measurement",
        "quantitative result" ;
    scl:tag "measurement",
        "numeric",
        "result" ;
    rdfs:comment "The numeric measured value of the laboratory test result reported for the subject at the given visit." ;
    rdfs:domain ind:LabResults ;
    rdfs:range xsd:double ;
    skos:altLabel "lab value",
        "measured value",
        "numeric result",
        "test result" .

ind:labResults_studyId a owl:ObjectProperty ;
    rdfs:label "study_id" ;
    scl:fkProvenance "AI_INFERRED" ;
    scl:glossaryTerm "clinical study",
        "study identifier",
        "trial protocol" ;
    scl:tag "clinical_trials",
        "identifier",
        "study" ;
    rdfs:comment "Identifier for the clinical study or trial protocol under which the lab sample was collected. (Foreign key: lab_results.study_id references studies.study_id)" ;
    rdfs:domain ind:LabResults ;
    rdfs:range ind:Studies ;
    skos:altLabel "protocol ID",
        "study code",
        "trial ID" .

ind:labResults_subjectId a owl:ObjectProperty ;
    rdfs:label "subject_id" ;
    scl:fkProvenance "AI_INFERRED" ;
    scl:glossaryTerm "enrolled subject",
        "participant",
        "trial subject" ;
    scl:tag "clinical_trials",
        "identifier",
        "subject" ;
    rdfs:comment "Unique identifier for the clinical trial participant (subject) from whom the lab sample was collected. (Foreign key: lab_results.subject_id references subjects.subject_id)" ;
    rdfs:domain ind:LabResults ;
    rdfs:range ind:Subjects ;
    skos:altLabel "participant ID",
        "patient ID",
        "subject code" .

ind:labResults_testCode a owl:DatatypeProperty ;
    rdfs:label "test_code" ;
    scl:glossaryTerm "LOINC code",
        "analyte",
        "laboratory test code" ;
    scl:tag "code",
        "laboratory",
        "test" ;
    rdfs:comment "Standardized short code identifying the specific laboratory test performed, such as 'HGB' for hemoglobin or 'ALT' for alanine aminotransferase." ;
    rdfs:domain ind:LabResults ;
    rdfs:range xsd:string ;
    skos:altLabel "analyte code",
        "lab code",
        "test identifier" .

ind:labResults_testName a owl:DatatypeProperty ;
    rdfs:label "test_name" ;
    scl:glossaryTerm "analyte name",
        "laboratory test" ;
    scl:tag "laboratory",
        "name",
        "test" ;
    rdfs:comment "Descriptive name of the laboratory test performed, providing a human-readable label corresponding to the test code." ;
    rdfs:domain ind:LabResults ;
    rdfs:range xsd:string ;
    skos:altLabel "analyte name",
        "lab test name",
        "test description" .

ind:labResults_visit a owl:DatatypeProperty ;
    rdfs:label "visit" ;
    scl:glossaryTerm "protocol visit",
        "study visit",
        "visit schedule" ;
    scl:tag "clinical_trials",
        "timepoint",
        "visit" ;
    rdfs:comment "The scheduled or unscheduled study visit at which the lab sample was collected, such as Baseline, Week 4, or End of Study." ;
    rdfs:domain ind:LabResults ;
    rdfs:range xsd:string ;
    skos:altLabel "study visit",
        "timepoint",
        "visit label",
        "visit name" .

ind:matchConfidence a owl:AnnotationProperty .

ind:meddraDictionary_preferredTerm a owl:DatatypeProperty ;
    rdfs:label "preferred_term" ;
    scl:glossaryTerm "MedDRA PT",
        "Medical Concept",
        "Preferred Term" ;
    scl:tag "adverse_event",
        "coding",
        "meddra",
        "terminology" ;
    rdfs:comment "The standardized MedDRA Preferred Term (PT) — a distinct medical concept used to describe symptoms, signs, diseases, diagnoses, or adverse events in a clinically recognized and internationally standardized manner." ;
    rdfs:domain ind:MeddraDictionary ;
    rdfs:range xsd:string ;
    skos:altLabel "Adverse Event Term",
        "Diagnosis Term",
        "Medical Term",
        "PT" .

ind:meddraDictionary_systemOrganClass a owl:DatatypeProperty ;
    rdfs:label "system_organ_class" ;
    scl:glossaryTerm "Body System Classification",
        "MedDRA Hierarchy",
        "SOC",
        "System Organ Class" ;
    scl:tag "classification",
        "hierarchy",
        "meddra",
        "regulatory",
        "safety" ;
    rdfs:comment "The highest level of the MedDRA hierarchy representing the System Organ Class (SOC), which groups Preferred Terms by etiology, manifestation site, or purpose (e.g., 'Cardiac disorders', 'Gastrointestinal disorders') for regulatory and safety reporting." ;
    rdfs:domain ind:MeddraDictionary ;
    rdfs:range xsd:string ;
    skos:altLabel "Body System",
        "MedDRA SOC",
        "Organ Class",
        "SOC" .

ind:protocolDeviations_category a owl:DatatypeProperty ;
    rdfs:label "category" ;
    scl:glossaryTerm "GCP classification",
        "deviation category",
        "protocol violation type" ;
    scl:tag "classification",
        "compliance",
        "regulatory" ;
    rdfs:comment "Classification of the protocol deviation into a predefined type or category (e.g., informed consent, dosing error, eligibility criteria), used for trending and regulatory reporting." ;
    rdfs:domain ind:ProtocolDeviations ;
    rdfs:range xsd:string ;
    skos:altLabel "deviation classification",
        "deviation type",
        "violation category" .

ind:protocolDeviations_description a owl:DatatypeProperty ;
    rdfs:label "description" ;
    scl:glossaryTerm "deviation description",
        "non-compliance narrative",
        "protocol violation details" ;
    scl:tag "compliance",
        "narrative",
        "text" ;
    rdfs:comment "Narrative description of the protocol deviation, detailing the nature of the non-compliance, what occurred, and how it differed from the approved study protocol." ;
    rdfs:domain ind:ProtocolDeviations ;
    rdfs:range xsd:string ;
    skos:altLabel "deviation details",
        "deviation narrative",
        "deviation summary" .

ind:protocolDeviations_deviationDate a owl:DatatypeProperty ;
    rdfs:label "deviation_date" ;
    scl:glossaryTerm "deviation date",
        "event date",
        "occurrence date" ;
    scl:tag "compliance",
        "date",
        "temporal" ;
    rdfs:comment "The calendar date on which the protocol deviation occurred or was identified, used for timelines, regulatory submissions, and trend analysis." ;
    rdfs:domain ind:ProtocolDeviations ;
    rdfs:range xsd:date ;
    skos:altLabel "date of deviation",
        "occurrence date",
        "violation date" .

ind:protocolDeviations_siteId a owl:ObjectProperty ;
    rdfs:label "site_id" ;
    scl:fkProvenance "AI_INFERRED" ;
    scl:glossaryTerm "clinical site",
        "investigative site",
        "trial site" ;
    scl:tag "foreign_key",
        "identifier",
        "site" ;
    rdfs:comment "Identifier of the clinical trial site where the protocol deviation was observed, enabling site-level deviation tracking and monitoring. (Foreign key: protocol_deviations.site_id references sites.site_id)" ;
    rdfs:domain ind:ProtocolDeviations ;
    rdfs:range ind:Sites ;
    skos:altLabel "clinical site number",
        "investigative site ID",
        "site code" .

ind:protocolDeviations_studyId a owl:ObjectProperty ;
    rdfs:label "study_id" ;
    scl:fkProvenance "AI_INFERRED" ;
    scl:glossaryTerm "clinical study",
        "study identifier",
        "trial protocol" ;
    scl:tag "foreign_key",
        "identifier",
        "study" ;
    rdfs:comment "Identifier of the clinical study or trial in which the protocol deviation occurred, used to associate the deviation with a specific research protocol. (Foreign key: protocol_deviations.study_id references studies.study_id)" ;
    rdfs:domain ind:ProtocolDeviations ;
    rdfs:range ind:Studies ;
    skos:altLabel "protocol ID",
        "study number",
        "trial ID" .

ind:protocolDeviations_subjectId a owl:ObjectProperty ;
    rdfs:label "subject_id" ;
    scl:fkProvenance "AI_INFERRED" ;
    scl:glossaryTerm "study participant",
        "subject enrollment",
        "trial subject" ;
    scl:tag "foreign_key",
